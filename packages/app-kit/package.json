{
  "name": "@sjolystinnovation/app-kit",
  "version": "0.6.0",
  "description": "Building blocks for Next.js apps that sign in against a JWT API through next-auth",
  "license": "Apache-2.0",
  "author": "Sjølyst Innovation AS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sondresjolyst/si-web-packages.git",
    "directory": "packages/app-kit"
  },
  "homepage": "https://github.com/sondresjolyst/si-web-packages#readme",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./session": "./src/session/index.ts",
    "./session/react": "./src/session/react/index.ts",
    "./forms": "./src/forms/index.ts",
    "./auth": "./src/auth/index.ts",
    "./api": "./src/api/index.ts",
    "./ui": "./src/ui/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "src",
    "!src/tests"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@heroicons/react": "^2",
    "axios": "^1.20.0",
    "next": "^16",
    "next-auth": "^4.24",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@heroicons/react": "^2.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "axios": "^1.20.0",
    "jsdom": "^30.1.1",
    "next": "^16.3.6",
    "next-auth": "^4.24.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "next.js",
    "next-auth",
    "session",
    "jwt",
    "react",
    "tailwindcss"
  ],
  "dependencies": {
    "@types/jsonwebtoken": "^9.0.8",
    "jsonwebtoken": "^9.0.2"
  }
}
